[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/droidianos/droidianos-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/droidianos/droidianos-wallpaper.png'
picture-options='zoom'
primary-color='#12242a'
secondary-color='#02080a'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/droidianos/droidianos-wallpaper.png'
primary-color='#12242a'
secondary-color='#02080a'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/droidianos/droidianos-wallpaper.png'
picture-options='zoom'
color-shading-type='solid'
primary-color='#12242a'
secondary-color='#02080a'
