#!/bin/sh
set -e

case "$1" in
  configure)
    install -m 0644 /usr/share/droidianos-branding/os-release /usr/lib/os-release
    install -m 0644 /usr/share/droidianos-branding/issue /etc/issue
    install -m 0644 /usr/share/droidianos-branding/issue.net /etc/issue.net
    install -m 0644 /usr/share/droidianos-branding/motd /etc/motd
    if command -v update-alternatives >/dev/null 2>&1; then
      update-alternatives --install \
        /usr/share/images/vendor-logos \
        vendor-logos \
        /usr/share/droidianos-branding/vendor-logos 100 \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor.png emblem-vendor-64 /usr/share/droidianos-branding/vendor-logos/logo-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor.png emblem-vendor-128 /usr/share/droidianos-branding/vendor-logos/logo-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor.png emblem-vendor-256 /usr/share/droidianos-branding/vendor-logos/logo-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg emblem-vendor-scalable /usr/share/droidianos-branding/vendor-logos/logo.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-64 /usr/share/droidianos-branding/vendor-logos/logo-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-128 /usr/share/droidianos-branding/vendor-logos/logo-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-256 /usr/share/droidianos-branding/vendor-logos/logo-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-symbolic.svg emblem-vendor-symbolic-scalable /usr/share/droidianos-branding/vendor-logos/logo.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-white.png emblem-vendor-white-64 /usr/share/droidianos-branding/vendor-logos/logo-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-white.png emblem-vendor-white-128 /usr/share/droidianos-branding/vendor-logos/logo-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-white.png emblem-vendor-white-256 /usr/share/droidianos-branding/vendor-logos/logo-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-white.svg emblem-vendor-white-scalable /usr/share/droidianos-branding/vendor-logos/logo.svg
      update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme /usr/share/desktop-base/droidianos-theme 100
      update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/desktop-base/droidianos-theme/background.svg 100
      update-alternatives --install /usr/share/images/desktop-base/login-background.svg desktop-login-background /usr/share/desktop-base/droidianos-theme/background.svg 100
      update-alternatives --install /usr/share/images/desktop-base/desktop-grub.png desktop-grub /usr/share/droidianos-branding/droidianos-bootloader.png 100 \
        --slave /usr/share/desktop-base/grub_background.sh desktop-grub.sh /usr/share/desktop-base/droidianos-theme/grub/grub_background.sh
      update-alternatives --install /usr/share/wallpapers/DebianTheme desktop-plasma5-wallpaper /usr/share/wallpapers/droidianOS 100
      update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/droidianos/droidianos.plymouth 100
    fi
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
      plymouth-set-default-theme -R droidianos || true
    fi
    if command -v glib-compile-schemas >/dev/null 2>&1; then
      glib-compile-schemas /usr/share/glib-2.0/schemas || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -q /usr/share/icons/hicolor || true
    fi
    if command -v update-grub >/dev/null 2>&1; then
      update-grub || true
    fi
    ;;
esac

#DEBHELPER#
