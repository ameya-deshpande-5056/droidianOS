[Desktop Entry]
Type=Application
Name=droidianOS Desktop Setup
Comment=Choose and install your preferred desktop environment on first login
Exec=droidianos-desktop-chooser
Icon=droidianos
Terminal=false
Categories=System;Settings;
OnlyShowIn=GNOME;KDE;XFCE;LXQt;LXDE;Openbox;
X-GNOME-Autostart-enabled=true
