[Unit]
Description=Verify Waydroid startup for droidianOS
Documentation=file:/usr/share/doc/droidianos-waydroid-image/README.md
After=local-fs.target dbus.service
Before=display-manager.service graphical.target
ConditionPathExists=!/var/lib/droidianos/waydroid-firstboot-complete

[Service]
Type=oneshot
ExecStart=/usr/lib/droidianos/waydroid-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
