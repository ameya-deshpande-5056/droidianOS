#!/bin/sh
set -eu

STATE_DIR="/var/lib/droidianos"
INSTALL_MARKER="$STATE_DIR/waydroid-installed"
COMPLETE_MARKER="$STATE_DIR/waydroid-firstboot-complete"

mkdir -p "$STATE_DIR"

if [ -f "$COMPLETE_MARKER" ]; then
  exit 0
fi

if ! command -v waydroid >/dev/null 2>&1; then
  echo "waydroid command not found" >&2
  exit 1
fi

if [ ! -f "$INSTALL_MARKER" ] || [ ! -s /var/lib/waydroid/waydroid.cfg ]; then
  /usr/lib/droidianos/waydroid-install
fi

systemctl enable waydroid-container.service
systemctl start waydroid-container.service
systemctl is-active --quiet waydroid-container.service

touch "$COMPLETE_MARKER"
