#!/bin/sh
set -eu

STATE_DIR="/var/lib/droidianos"
MARKER="$STATE_DIR/waydroid-initialized"
SYSTEM_IMAGE="/var/lib/waydroid/images/system.img"
VENDOR_IMAGE="/var/lib/waydroid/images/vendor.img"

mkdir -p "$STATE_DIR"

if [ -f "$MARKER" ]; then
  exit 0
fi

if ! command -v waydroid >/dev/null 2>&1; then
  echo "waydroid command not found" >&2
  exit 1
fi

if [ ! -f "$SYSTEM_IMAGE" ] || [ ! -f "$VENDOR_IMAGE" ]; then
  waydroid init
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl enable waydroid-container.service >/dev/null 2>&1 || true
  systemctl start waydroid-container.service >/dev/null 2>&1 || true
fi

touch "$MARKER"

