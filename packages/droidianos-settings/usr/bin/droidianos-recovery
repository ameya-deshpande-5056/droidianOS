#!/bin/sh
set -eu

command="${1:-status}"

case "$command" in
  status)
    systemctl --user status droidianos-integrationd.service droidianos-apk-installerd.service droidianos-permissionsd.service droidianos-updated.service --no-pager || true
    waydroid status || true
    ;;
  restart)
    systemctl --user restart droidianos-integrationd.service || true
    systemctl --user restart droidianos-apk-installerd.service || true
    systemctl --user restart droidianos-permissionsd.service || true
    systemctl --user restart droidianos-updated.service || true
    systemctl --user restart droidianos-notification-bridge.service || true
    ;;
  refresh)
    droidianos-integrationd --refresh
    ;;
  reset-waydroid)
    systemctl --user stop droidianos-integrationd.service droidianos-notification-bridge.service || true
    sudo systemctl restart waydroid-container.service
    systemctl --user start droidianos-integrationd.service droidianos-notification-bridge.service || true
    ;;
  clear-cache)
    rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/droidianos"
    ;;
  *)
    echo "usage: droidianos-recovery [status|restart|refresh|reset-waydroid|clear-cache]" >&2
    exit 2
    ;;
esac

